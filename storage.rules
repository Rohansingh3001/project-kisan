rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload crop images to their own folder
    match /crop-images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Voice recordings are private to users
    match /voice-recordings/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public assets
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
